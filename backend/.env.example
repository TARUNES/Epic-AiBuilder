# ==============================================================================
# EPIC-Hour Environment Variables
# ==============================================================================

# Google Gemini API Key (Get at: https://aistudio.google.com/)
# Used for:
# - gemini-2.5-flash (Multilingual SOS triage & Pharmacy OTC extraction)
# - text-embedding-004 (768-dim semantic de-duplication)
# - gemini-2.5-pro (Spatio-temporal epidemic reasoning & Function Calling)
GEMINI_API_KEY=

# Google Maps API Key (Geocoding & Frontend Map tiles)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Mock Mode (Set to true to use stateful in-memory store seeded from mock_dataset.json)
# If GEMINI_API_KEY is not set or MOCK_MODE=true, fallback offline parsers ensure 100% functionality
MOCK_MODE=false

# Google Cloud Firestore (Optional - for cloud persistence)
# Set path to service account json or leave blank for local stateful memory
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROJECT_ID=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
